# ── VYNE API — local development env ─────────────────────────────────────────
# Copy to .env and fill in. NEVER commit real keys. On Cloud Run these come
# from Secret Manager (see deploy/deploy.sh), not from a file.

NODE_ENV=development
PORT=8080

# Local Postgres (docker compose up -d postgres).
# NOTE: the app should connect as the NON-OWNER role so RLS applies:
DATABASE_URL=postgres://vyne_app:change-me-via-ops@localhost:5432/vyne
# Migrations run as the owner role:
#   DATABASE_URL=postgres://vyne:vyne@localhost:5432/vyne npm run migrate

# GCP project (required for Vertex adapters + Identity Platform admin).
GOOGLE_CLOUD_PROJECT=
# Claude region on Vertex (us-east5 is the common Claude region).
VERTEX_LOCATION=us-east5
# Local admin credentials for Identity Platform / Vertex (service account JSON):
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini via AI Studio — FREE TIER, dev/testing default.
# Free tier may use prompts for product improvement → dev/sandbox ONLY.
GEMINI_API_KEY=

# Optional additional providers (activate by adding to a routing chain):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Natural agent voice (Gemini TTS). Voice options include: Kore (default,
# warm professional), Puck, Charon, Aoede, Fenrir, Leda, Orus, Zephyr.
# GEMINI_TTS_VOICE=Kore
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Optional: pin a specific Gemini model (default: gemini-flash-latest, a
# rolling alias that never goes stale). List what your key can use with:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY" | grep '"name"'
# GEMINI_MODEL=gemini-3.6-flash

# Optional: override the default provider chain, comma-separated.
# LLM_DEFAULT_CHAIN=gemini-aistudio,gemini-vertex,anthropic-vertex

# Production hard-blocks free-tier adapters. Set to 1 ONLY to consciously
# allow free tier outside dev (e.g. a sandbox deployment).
# ALLOW_FREE_TIER=
