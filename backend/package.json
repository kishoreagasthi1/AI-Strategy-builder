{
  "name": "vyne-api",
  "version": "0.1.0",
  "description": "VYNE Platform SaaS backend — multi-tenant API + LLM gateway (Phase 0 foundation)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:rls": "RLS_TEST=1 vitest run test/rls.test.ts",
    "test:full": "RLS_TEST=1 vitest run",
    "seed:dev": "tsx src/db/seedDev.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "@sentry/node": "^10.69.0",
    "fastify": "^5.2.0",
    "firebase-admin": "^13.0.2",
    "google-auth-library": "^9.15.0",
    "pg": "^8.13.1",
    "stripe": "^22.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
