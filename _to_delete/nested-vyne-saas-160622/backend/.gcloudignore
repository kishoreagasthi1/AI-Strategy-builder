# v5.32.30: gcloud run deploy --source . runs FROM backend/, so the root
# .gcloudignore never applied to it. This is the one that does.
# v5.32.29 (audit Low). There was no ignore file at all, so `deploy.sh api`
# (gcloud run deploy --source .) uploaded whatever sat in the working tree
# into the Cloud Build staging bucket — including a developer's .env.
node_modules/
dist/
.env
.env.*
!.env.example
*.log
.DS_Store
coverage/
.vscode/
.idea/
test/
