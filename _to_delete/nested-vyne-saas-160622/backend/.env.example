# ── VYNE API — local development env ─────────────────────────────────────────
# Copy to .env and fill in. NEVER commit real keys. On Cloud Run these come
# from Secret Manager (see deploy/deploy.sh), not from a file.

NODE_ENV=development
PORT=8080

# Zero-setup local login (no GCP/Identity Platform needed) — NEVER set on a
# reachable deployment. V225-audit M2 fix: dev tokens are HMAC-signed, so
# DEV_AUTH=1 additionally requires DEV_AUTH_SECRET (any random string is
# fine locally; the frontend never sees it — it calls POST
# /api/dev/mint-token to get a signed token). Both unset = dev auth is off.
# DEV_AUTH=1
# DEV_AUTH_SECRET=

# Local Postgres (docker compose up -d postgres).
# NOTE: the app should connect as the NON-OWNER role so RLS applies:
DATABASE_URL=postgres://vyne_app:change-me-via-ops@localhost:5432/vyne
# Migrations run as the owner role:
#   DATABASE_URL=postgres://vyne:vyne@localhost:5432/vyne npm run migrate

# GCP project (required for Vertex adapters + Identity Platform admin).
GOOGLE_CLOUD_PROJECT=
# Claude's serving location on Vertex — "global" as of v5.32.1 (Claude on
# Vertex moved off region-pinned serving; leave this unset/global unless
# Anthropic's Vertex docs say otherwise for your model version).
VERTEX_LOCATION=global
# Local admin credentials for Identity Platform / Vertex (service account JSON):
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini via AI Studio — FREE TIER, dev/testing default.
# Free tier may use prompts for product improvement → dev/sandbox ONLY.
GEMINI_API_KEY=

# Optional additional providers (activate by adding to a routing chain):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── REALTIME VOICE (Gemini Live) ─────────────────────────────────────────────
# The interviewer's speech-native path. Two things must be true or the client
# silently falls back to text + TTS — a working interview in a robotic voice,
# which is why this fails without alerting anyone:
#
#  1. GEMINI_LIVE_MODEL must name a model the account exposes for
#     bidiGenerateContent. The code default is now the production value, so
#     leaving this unset is safe; set it only to pin a newer model. A model that
#     is not Live-capable MINTS a token fine and is then rejected by the
#     WebSocket with close 1007 ("token-based requests cannot use project-scoped
#     features such as tuned models"), because a name Google cannot resolve as a
#     public model falls through to a project-scoped lookup an ephemeral token
#     cannot do. Known-good ids are listed in LIVE_CAPABLE_MODELS (liveSession.ts).
# GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-latest
#
#  2. GEMINI_API_KEY must be a BILLED key enabled for the realtime
#     /v1alpha/auth_tokens API. A free AI Studio key is rejected on the realtime
#     path even though it works for ordinary generation — so live voice cannot be
#     exercised locally on a free key, and a local run on one does NOT reproduce
#     production. Set GEMINI_PAID=1 with a billed key.
# GEMINI_PAID=1
# GEMINI_LIVE_VOICE=Aoede
#
# List what your key can actually use for Live:
#   curl -s -H "x-goog-api-key: $GEMINI_API_KEY" \
#     "https://generativelanguage.googleapis.com/v1beta/models" \
#     | grep -B3 bidiGenerateContent | grep '"name"'

# Natural agent voice (Gemini TTS). Voice options include: Kore (default,
# warm professional), Puck, Charon, Aoede, Fenrir, Leda, Orus, Zephyr.
# GEMINI_TTS_VOICE=Kore
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Optional: pin a specific Gemini model (default: gemini-flash-latest, a
# rolling alias that never goes stale). List what your key can use with:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY" | grep '"name"'
# GEMINI_MODEL=gemini-3.6-flash

# Optional: override the default provider chain, comma-separated.
# LLM_DEFAULT_CHAIN=gemini-aistudio,gemini-vertex,anthropic-vertex

# Production hard-blocks free-tier adapters. Set to 1 ONLY to consciously
# allow free tier outside dev (e.g. a sandbox deployment).
# ALLOW_FREE_TIER=

# Error monitoring/alerting (optional). Unset = monitoring fully off, zero
# behavior change (see src/monitoring/sentry.ts). Set to a real project DSN
# from sentry.io (or a self-hosted Sentry instance) to start receiving
# unhandled-error alerts from this API.
# SENTRY_DSN=

# SaaS subscription billing (optional) — what a TENANT FIRM pays to use
# VYNE itself, via Stripe (see src/billing/, routes/subscriptions.ts).
# Distinct from the client cost-recovery billing in routes/billing.ts,
# which needs no configuration at all.
#
# Unset STRIPE_SECRET_KEY = billing routes stay up (GET /api/plans still
# works) but checkout/portal/webhooks all respond "billing_not_configured".
# STRIPE_SECRET_KEY=
# From the webhook endpoint's settings in the Stripe dashboard, once you've
# pointed it at https://<your-api>/api/webhooks/stripe:
# STRIPE_WEBHOOK_SECRET=
# Trusted origin Checkout/portal success/cancel/return URLs are built from
# — required for checkout/portal to work once STRIPE_SECRET_KEY is set.
# Also pins CORS to this exact origin (server.ts) instead of the permissive
# fallback used when this is unset — set it in any real deployment.
# APP_BASE_URL=https://your-frontend.example.com
#
# The paywall (actually blocking LLM usage without a live subscription) is
# a SEPARATE switch from the above — leave unset until you're ready to
# enforce it; every tenant provisioned before this feature existed defaults
# to a trial state that would otherwise start expiring the moment this
# flips on.
# STRIPE_ENFORCE_PAYWALL=
# Grace period (days from signup) before a tenant that never subscribed
# gets locked out, once STRIPE_ENFORCE_PAYWALL=1. Default 14.
# TRIAL_DAYS=14

# Before offering a plan for checkout: create a matching Product/Price in
# the Stripe dashboard, then set its price id —
#   UPDATE subscription_plans SET stripe_price_id = 'price_...' WHERE key = 'sprint';
# — for 'sprint' | 'transformation' | 'caio' (migration 009_subscriptions.sql
# seeds these three purchasable plans with illustrative placeholder prices;
# review/adjust monthly_price_usd there before go-live too).
